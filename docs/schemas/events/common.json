{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/common.json",
  "title": "Definitions shared by event and WebSocket schemas",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC 3339 in UTC."
    },
    "money": {
      "type": "object",
      "required": ["amount_paise", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount_paise": {"type": "integer"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "point": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "city_id": {"type": "string", "pattern": "^[a-z]{3,8}$"},
    "category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,19}$"},
    "zone_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{15}|area:[A-Z0-9-]{2,40})$",
      "description": "An H3 resolution-7 cell, or area:<code> for a special area."
    },
    "method_type": {"enum": ["CASH", "CARD", "UPI"]},
    "charge_purpose": {"enum": ["FARE", "CANCELLATION_FEE", "NO_SHOW_FEE"]},
    "ride_status": {
      "enum": ["SEARCHING", "DRIVER_ASSIGNED", "DRIVER_ARRIVED", "IN_TRIP", "COMPLETED",
               "CANCELLED_BY_RIDER", "CANCELLED_BY_DRIVER", "CANCELLED_BY_SYSTEM", "DRIVER_NOT_FOUND"]
    },
    "availability_status": {"enum": ["OFFLINE", "AVAILABLE", "OFFERED", "ASSIGNED", "ON_TRIP"]},
    "rating_summary": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "average": {"type": "number", "minimum": 1, "maximum": 5},
        "count": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
