{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/OfferWithdrawn.v1.json",
  "title": "OfferWithdrawn v1",
  "description": "The platform ended a pending offer: the rider cancelled, the search timed out, operations cancelled the ride, or the driver was suspended. Aggregate: offer; key: ride.",
  "type": "object",
  "required": ["offer_id", "ride_id", "driver_id", "reason", "withdrawn_at"],
  "additionalProperties": false,
  "properties": {
    "offer_id": {"$ref": "common.json#/$defs/uuid"},
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "reason": {"enum": ["RIDER_CANCELLED", "SEARCH_TIMEOUT", "OPS_CANCELLED", "SUSPENDED"]},
    "withdrawn_at": {"$ref": "common.json#/$defs/timestamp"}
  },
  "examples": [
    {
      "offer_id": "0199a3f0-8a11-7e22-9f33-a44b55c66d77",
      "ride_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "driver_id": "0199a3d2-9e8f-7c6b-a5d4-c3b2a1f0e9d8",
      "reason": "RIDER_CANCELLED",
      "withdrawn_at": "2026-10-02T08:15:11.000Z"
    }
  ]
}
