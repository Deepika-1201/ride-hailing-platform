{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/envelope.v1.json",
  "title": "Event envelope, version 1",
  "description": "Every event in the outbox and on Kafka (ADR-008). The payload is validated by <event_type>.v<event_version>.json.",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "aggregate_type", "aggregate_id", "aggregate_version",
               "occurred_at", "producer", "correlation_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"$ref": "common.json#/$defs/uuid", "description": "UUIDv7; the deduplication key."},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Za-z]{2,60}$"},
    "event_version": {"type": "integer", "minimum": 1},
    "aggregate_type": {"enum": ["ride", "offer", "availability", "driver", "charge", "refund", "rating"]},
    "aggregate_id": {"$ref": "common.json#/$defs/uuid"},
    "aggregate_version": {"type": "integer", "minimum": 0},
    "occurred_at": {"$ref": "common.json#/$defs/timestamp"},
    "producer": {"type": "string", "pattern": "^[a-z]+/(api|realtime|dispatch|worker)$", "description": "Module and role."},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 100, "description": "The ride ID in ride flows."},
    "causation_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "trace_parent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "payload": {"type": "object"}
  },
  "examples": [
    {
      "event_id": "0199a3f0-7d01-7e02-8f03-a1b2c3d4e5f6",
      "event_type": "DriverAssigned",
      "event_version": 1,
      "aggregate_type": "ride",
      "aggregate_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "aggregate_version": 1,
      "occurred_at": "2026-10-02T08:15:21.402Z",
      "producer": "ride/api",
      "correlation_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "causation_id": "req_7f3c2a91",
      "trace_parent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "payload": {
        "ride_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
        "rider_id": "0199a3e1-2b4c-7d10-8e9f-1a2b3c4d5e6f",
        "driver_id": "0199a3d2-9e8f-7c6b-a5d4-c3b2a1f0e9d8",
        "vehicle_id": "0199a3d2-a001-7b2c-8d3e-4f5a6b7c8d9e",
        "offer_id": "0199a3f0-8a11-7e22-9f33-a44b55c66d77",
        "promised_pickup_eta_s": 240,
        "reassign_count": 0,
        "assigned_at": "2026-10-02T08:15:21.402Z"
      }
    }
  ]
}
