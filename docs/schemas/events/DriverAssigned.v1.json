{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/DriverAssigned.v1.json",
  "title": "DriverAssigned v1",
  "description": "A driver accepted the ride's offer (T2). Aggregate: ride. Never carries the PIN.",
  "type": "object",
  "required": ["ride_id", "rider_id", "driver_id", "vehicle_id", "offer_id", "promised_pickup_eta_s",
               "reassign_count", "assigned_at"],
  "additionalProperties": false,
  "properties": {
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "rider_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "vehicle_id": {"$ref": "common.json#/$defs/uuid"},
    "offer_id": {"$ref": "common.json#/$defs/uuid"},
    "promised_pickup_eta_s": {"type": "integer", "minimum": 0},
    "reassign_count": {"type": "integer", "minimum": 0},
    "assigned_at": {"$ref": "common.json#/$defs/timestamp"}
  },
