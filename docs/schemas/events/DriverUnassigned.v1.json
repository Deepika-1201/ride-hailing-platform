{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/DriverUnassigned.v1.json",
  "title": "DriverUnassigned v1",
  "description": "The assigned driver cancelled before arriving (T6) or was unreachable (T7); the ride is searching again. Aggregate: ride.",
  "type": "object",
  "required": ["ride_id", "rider_id", "driver_id", "reason", "search_generation", "unassigned_at"],
  "additionalProperties": false,
  "properties": {
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "rider_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "reason": {"enum": ["DRIVER_CANCELLED", "DRIVER_UNREACHABLE"]},
    "search_generation": {"type": "integer", "minimum": 2},
    "unassigned_at": {"$ref": "common.json#/$defs/timestamp"}
  },
  "examples": [
    {
      "ride_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "rider_id": "0199a3e1-2b4c-7d10-8e9f-1a2b3c4d5e6f",
      "driver_id": "0199a3d2-9e8f-7c6b-a5d4-c3b2a1f0e9d8",
      "reason": "DRIVER_UNREACHABLE",
      "search_generation": 2,
      "unassigned_at": "2026-10-02T08:17:30.000Z"
    }
  ]
}
