{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/OfferCreated.v1.json",
  "title": "OfferCreated v1",
  "description": "A search attempt reserved a driver and offered the ride. Aggregate: offer; key: ride.",
  "type": "object",
  "required": ["offer_id", "ride_id", "driver_id", "attempt", "rank", "distance_m", "strategy", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "offer_id": {"$ref": "common.json#/$defs/uuid"},
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "attempt": {"type": "integer", "minimum": 0},
    "rank": {"type": "integer", "minimum": 1},
    "distance_m": {"type": "integer", "minimum": 0},
    "strategy": {"type": "string", "description": "Ranker name and version, e.g. nearest/1."},
    "expires_at": {"$ref": "common.json#/$defs/timestamp"}
  },
  "examples": [
    {
      "offer_id": "0199a3f0-8a11-7e22-9f33-a44b55c66d77",
      "ride_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "driver_id": "0199a3d2-9e8f-7c6b-a5d4-c3b2a1f0e9d8",
      "attempt": 0,
      "rank": 1,
      "distance_m": 840,
      "strategy": "nearest/1",
      "expires_at": "2026-10-02T08:15:17.410Z"
    }
  ]
}
