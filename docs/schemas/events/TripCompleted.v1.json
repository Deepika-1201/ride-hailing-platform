{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/TripCompleted.v1.json",
  "title": "TripCompleted v1",
  "description": "The driver ended the trip (T12). Carries what payment, earnings and ratings need. Aggregate: ride.",
  "type": "object",
  "required": ["ride_id", "rider_id", "driver_id", "city_id", "category", "fare", "commission",
               "payment_method_id", "payment_method_type", "completed_at"],
  "additionalProperties": false,
  "properties": {
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "rider_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "city_id": {"$ref": "common.json#/$defs/city_id"},
    "category": {"$ref": "common.json#/$defs/category"},
    "fare": {"$ref": "common.json#/$defs/money", "description": "The quoted fare, final."},
    "commission": {"$ref": "common.json#/$defs/money"},
    "payment_method_id": {"$ref": "common.json#/$defs/uuid"},
    "payment_method_type": {"$ref": "common.json#/$defs/method_type"},
    "completed_at": {"$ref": "common.json#/$defs/timestamp"},
    "device_time": {"$ref": "common.json#/$defs/timestamp"}
  },
  "examples": [
    {
      "ride_id": "0199a3f0-7c2e-7a41-9b3d-5f2e8c1d4a10",
      "rider_id": "0199a3e1-2b4c-7d10-8e9f-1a2b3c4d5e6f",
      "driver_id": "0199a3d2-9e8f-7c6b-a5d4-c3b2a1f0e9d8",
      "city_id": "blr",
      "category": "MINI",
      "fare": {"amount_paise": 25900, "currency": "INR"},
      "commission": {"amount_paise": 4934, "currency": "INR"},
      "payment_method_id": "0199a3e1-5555-7666-8777-888899990000",
      "payment_method_type": "CARD",
      "completed_at": "2026-10-02T08:47:12.000Z"
    }
  ]
}
