{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-hailing.example/schemas/events/OfferDeclined.v1.json",
  "title": "OfferDeclined v1",
  "description": "The driver declined, or went offline while the offer was pending. Aggregate: offer; key: ride.",
  "type": "object",
  "required": ["offer_id", "ride_id", "driver_id", "reason", "responded_at"],
  "additionalProperties": false,
  "properties": {
    "offer_id": {"$ref": "common.json#/$defs/uuid"},
    "ride_id": {"$ref": "common.json#/$defs/uuid"},
    "driver_id": {"$ref": "common.json#/$defs/uuid"},
    "reason": {"enum": ["DRIVER", "DRIVER_OFFLINE"]},
    "responded_at": {"$ref": "common.json#/$defs/timestamp"}
  },
  "examples": [
